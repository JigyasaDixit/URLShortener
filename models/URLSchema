const mongoose = require('mongoose');

const URLSchema = new mongoose.Schema({
    shortId: {
        type: String,
        required: true,
        unique: true
    },
    reDirectURL: {
        type: String,
        required: true
    },
    visitHistory: [{ timeStamp: { type: Number } }]
}, { timestamps: true });


const URL = new mongoose.model("url", URLSchema);

module.exports = URL;